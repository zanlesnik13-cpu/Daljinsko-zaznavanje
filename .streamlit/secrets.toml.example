# Copy this file to `.streamlit/secrets.toml` (ignored by git) or paste into
# Streamlit Community Cloud -> App Settings -> Secrets.

# Optional: GitHub Personal Access Token (fine-grained: Contents Read & Write)
# Enables automatic cloud persistence of user profiles in `data/`.
GITHUB_TOKEN = ""

# Optional: Target repository in "owner/repo" format (auto-detected from .git/config if omitted)
GITHUB_REPO = "zanlesnik13-cpu/Daljinsko-zaznavanje"

# Optional: Branch used for cloud persistence (default: "main")
GITHUB_BRANCH = "main"

# Optional: Google Gemini API key for Workspace 5 (AI Assistant)
GEMINI_API_KEY = ""

# Optional: Google Earth Engine (GEE) server-side backend for continental-scale analyses
# (100% optional — users without GEE continue using Microsoft Planetary Computer seamlessly)
# GEE_PROJECT_ID = "your-gcp-earth-engine-project-id"
# GEE_SERVICE_ACCOUNT_JSON = '''{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}'''
